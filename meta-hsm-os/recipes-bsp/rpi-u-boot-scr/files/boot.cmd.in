# U-Boot bootscript with RAUC A/B Dual-Slot Support

# Extract firmware bootargs from device tree populated by VideoCore GPU firmware
fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3
test -n "${BOOT_DEV}" || setenv BOOT_DEV "mmc 0:1"

setenv rauc_slot ""
setenv bootpart ""

for slot in ${BOOT_ORDER}; do
    if test "x${rauc_slot}" != "x"; then
        # Slot already chosen
    elif test "x${slot}" = "xA"; then
        if itest ${BOOT_A_LEFT} -gt 0; then
            setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
            echo "RAUC: Booting Slot A (Remaining attempts: ${BOOT_A_LEFT})"
            setenv rauc_slot "A"
            setenv rootdev "/dev/mmcblk0p2"
            setenv BOOT_DEV "mmc 0:2"
        fi
    elif test "x${slot}" = "xB"; then
        if itest ${BOOT_B_LEFT} -gt 0; then
            setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
            echo "RAUC: Booting Slot B (Remaining attempts: ${BOOT_B_LEFT})"
            setenv rauc_slot "B"
            setenv rootdev "/dev/mmcblk0p3"
            setenv BOOT_DEV "mmc 0:3"
        fi
    fi
done

if test -n "${rauc_slot}"; then
    setenv bootargs "${bootargs} root=${rootdev} rootwait rauc.slot=${rauc_slot}"
    saveenv
else
    echo "RAUC: No valid boot slots remaining. Resetting tries to 3."
    setenv BOOT_A_LEFT 3
    setenv BOOT_B_LEFT 3
    saveenv
    reset
fi

# Load kernel from active slot with fallback to mmc 0:1
if load ${BOOT_DEV} ${kernel_addr_r} boot/@@KERNEL_IMAGETYPE@@; then
    echo "RAUC: Successfully loaded kernel from ${BOOT_DEV}"
else
    echo "RAUC: Failed to load kernel from ${BOOT_DEV}, falling back to mmc 0:1 @@KERNEL_IMAGETYPE@@"
    load mmc 0:1 ${kernel_addr_r} @@KERNEL_IMAGETYPE@@
fi

if test ! -e mmc 0:1 uboot.env; then saveenv; fi;
@@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}
